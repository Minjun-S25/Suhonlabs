# Canonical origin for the site. Used for metadata, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL="https://suhonlabs.com"

# Public contact address. Leave empty until an official address exists —
# the site simply omits the address rather than showing a placeholder.
NEXT_PUBLIC_CONTACT_EMAIL=""

# Contact form delivery. The /api/contact route forwards submissions here as
# JSON (e.g. a Formspree, Resend proxy, Zapier or internal webhook endpoint).
# While unset, the form responds with a clear "not yet connected" message
# instead of silently dropping messages.
CONTACT_FORWARD_URL=""
# Optional bearer token sent with the forwarded request.
CONTACT_FORWARD_TOKEN=""

# Analytics readiness. The site loads no analytics unless a script URL is set.
# Example (Plausible):
#   NEXT_PUBLIC_ANALYTICS_SRC="https://plausible.io/js/script.js"
#   NEXT_PUBLIC_ANALYTICS_DOMAIN="suhonlabs.com"
NEXT_PUBLIC_ANALYTICS_SRC=""
NEXT_PUBLIC_ANALYTICS_DOMAIN=""
